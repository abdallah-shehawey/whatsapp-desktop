[Desktop Entry]
Type=Application
Name=Dardasha
Comment=Desktop client for WhatsApp Web
Exec=@BINDIR@/dardasha %u
Icon=io.github.abdallah_shehawey.dardasha
Terminal=false
Categories=Network;InstantMessaging;
Keywords=whatsapp;chat;messaging;dardasha;دردشة;
# Makes this client an option for the links "Open app" hands to the desktop;
# see src/links.js, which then asks to be the default.
MimeType=x-scheme-handler/whatsapp;
StartupNotify=true
StartupWMClass=Dardasha
SingleMainWindow=true
