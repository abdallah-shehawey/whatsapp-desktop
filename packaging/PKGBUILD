# Maintainer: Abdallah Shehawey <shehawey9@gmail.com>
pkgname=whatsapp-desktop
pkgver=0.1.0
pkgrel=1
pkgdesc='WhatsApp Web desktop client for Linux with tray integration and Arabic text fixes'
arch=('x86_64')
url='https://github.com/abdallah-shehawey/whatsapp-desktop'
license=('GPL-3.0-only')
depends=('alsa-lib' 'at-spi2-core' 'cairo' 'cups' 'dbus' 'gtk3' 'libdrm' 'libx11' 'libxcomposite' 'libxdamage' 'libxext' 'libxfixes' 'libxrandr' 'mesa' 'nspr' 'nss' 'pango' 'zlib')
makedepends=('git' 'npm')
source=("$pkgname-$pkgver.tar.gz::https://github.com/abdallah-shehawey/whatsapp-desktop/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  npm ci --ignore-scripts --no-audit --no-fund
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  local appdir="$pkgdir/usr/lib/$pkgname"

  install -dm755 "$appdir/resources/app" "$pkgdir/usr/bin"
  cp -a node_modules/electron/dist/. "$appdir/"
  rm -f "$appdir/electron"
  install -m755 node_modules/electron/dist/electron "$appdir/$pkgname"

  for locale in "$appdir"/locales/*.pak; do
    case "$(basename "$locale")" in
      ar.pak|en-US.pak) ;;
      *) rm -f "$locale" ;;
    esac
  done

  cp -a package.json src data "$appdir/resources/app/"
  printf '#!/bin/sh\nunset ELECTRON_RUN_AS_NODE\nexec /usr/lib/%s/%s "$@"\n' "$pkgname" "$pkgname" > "$pkgdir/usr/bin/$pkgname"
  chmod 755 "$pkgdir/usr/bin/$pkgname"

  for size in 16 22 24 32 48 64 128 256; do
    install -dm755 "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps"
    install -dm755 "$pkgdir/usr/share/icons/hicolor/${size}x${size}/status"
    install -m644 "data/icons/$size/apps/io.github.shehawey.whatsapp-desktop.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/"
    install -m644 "data/icons/$size/status/io.github.shehawey.whatsapp-desktop-tray.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/status/"
    install -m644 "data/icons/$size/status/io.github.shehawey.whatsapp-desktop-tray-attention.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/status/"
  done

  install -dm755 "$pkgdir/usr/share/applications"
  sed 's|@BINDIR@|/usr/bin|g' data/io.github.shehawey.whatsapp-desktop.desktop \
    > "$pkgdir/usr/share/applications/io.github.shehawey.whatsapp-desktop.desktop"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
