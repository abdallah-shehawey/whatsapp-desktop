#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_configure:

override_dh_auto_build:
	# Uncompiled application source: never run npm or download Electron here.

override_dh_auto_test:
	$(MAKE) test
	python3 tools/test-system-package.py

override_dh_auto_install:
	# The archive takes the project's Dardasha brand: see data/brands/dardasha.
	$(MAKE) install-system BRAND=dardasha DESTDIR=$(CURDIR)/debian/dardasha PREFIX=/usr SYSTEM_ELECTRON=/usr/bin/electron
	desktop-file-validate debian/dardasha/usr/share/applications/io.github.abdallah_shehawey.dardasha.desktop
	appstreamcli validate --no-net debian/dardasha/usr/share/metainfo/io.github.abdallah_shehawey.dardasha.metainfo.xml

override_dh_auto_clean:
	# Upstream 'make clean' removes development dependencies, not build products.
